{
    "template": "report_view",
    "description": "Show \"Content reporter\" if the user has no permission to view reporter #3",
    "execution_order": 6905,
    "enabled": true,
    "action": "preg_replace",
    "find": "#[\\t ]*<xf:avatar\\s+user=\"\\$comment\\.User\"[^>]*/>\\s*<h4 class=\"attribution\">\\s*<xf:username\\s+user=\"\\$comment\\.User\"[^>]*/></h4>#msi",
    "replace": "<xf:if is=\"$comment.is_report\">\n\t<xf:avatar user=\"$comment.ViewableUser\" size=\"xxs\" />\n\t<h4 class=\"attribution\"><xf:username user=\"$comment.ViewableUser\" rich=\"true\" /></h4>\n<xf:else />\n$0\n</xf:if>"
}